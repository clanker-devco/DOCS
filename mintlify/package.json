{
  "name": "clanker-documentation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "mint dev --port 3001 --no-open",
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write \"scripts/**/*.mjs\" \"../.github/**/*.yml\" \"../.vscode/*.json\" \"../.prettierrc.json\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"../.github/**/*.yml\" \"../.vscode/*.json\" \"../.prettierrc.json\"",
    "lint": "node scripts/check-docs.mjs && node scripts/check-gitbook.mjs && node scripts/sync-guides.mjs --check",
    "test": "node --test scripts/*.test.mjs",
    "build": "mint validate",
    "links": "node scripts/check-docs.mjs --links-only",
    "links:mint": "mint broken-links",
    "check:preview": "node scripts/check-preview.mjs",
    "import:api": "node scripts/import-generated.mjs api",
    "import:sdk": "node scripts/import-generated.mjs sdk",
    "sync:guides": "node scripts/sync-guides.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "github-slugger": "2.0.0",
    "mint": "4.2.687",
    "prettier": "3.9.6",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.8.1"
  }
}
