{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,

  // Pages are synced from GitBook or generated by scripts; don't reformat them on save.
  "[markdown]": {
    "editor.formatOnSave": false
  },
  "[mdx]": {
    "editor.formatOnSave": false
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/package-lock.json": true,
    "mintlify/assets/sdk-types": true
  }
}
